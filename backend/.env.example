# ---------------------------------------------------------------
# JobHunter backend configuration
# Copy to `.env` and fill in your values. Never commit the real `.env`.
# ---------------------------------------------------------------

# --- App ---------------------------------------------------------
APP_NAME=JobHunter
APP_VERSION=1.0.0
ENVIRONMENT=development          # development | production
DEBUG=false

# --- Database ----------------------------------------------------
# Either set DATABASE_URL directly…
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/jobhunter
# …or use the individual parts (used when DATABASE_URL is empty):
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobhunter
DB_ECHO=false

# --- Logging ---------------------------------------------------------
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
# LOG_FILE=logs/jobhunter.log    # optional file output (rotating)

# --- Security / HTTP -------------------------------------------------
# Comma-separated list of allowed CORS origins. In development the local
# dev origins are appended automatically; in production this is the ONLY
# list used.
# CORS_ORIGINS=http://localhost:5173,https://jobs.example.com
# TRUSTED_HOSTS=localhost,127.0.0.1,jobs.example.com

# --- Rate limiting ----------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120          # max requests per window per client IP
RATE_LIMIT_WINDOW_SECONDS=60

# --- Scheduler ----------------------------------------------------------
SCHEDULE_ENABLED=true            # start the automated scrape loop in the API
SCHEDULE_INTERVAL_MINUTES=60
SCHEDULE_RUN_ON_STARTUP=true

# --- Notifications -------------------------------------------------
NOTIFICATIONS_ENABLED=true
NOTIFY_MAX_PER_RUN=20            # cap on jobs notified per run
# Discord — set a webhook URL to enable this channel.
DISCORD_WEBHOOK_URL=
# Telegram — set bot token + chat id to enable this channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Job matching rules ---------------------------------------------
# A job is notified when it passes these rules (all enabled rules must pass).
MATCH_KEYWORDS=python,remote      # comma-separated
MATCH_SOURCES=                    # comma-separated allowed sources (empty = any)
MATCH_REQUIRE_ALL_KEYWORDS=false
MATCH_REMOTE_ONLY=false
MATCH_MIN_SALARY=0                # annualized USD minimum (0 = disabled)

# --- Optional scrapers ------------------------------------------------
# UPWORK_TOKEN=                   # Upwork API token (optional; else Upwork is skipped)